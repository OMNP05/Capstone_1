# ---------------------------------------------------------------------------
# Disruption Orchestrator — environment
# Copy to .env and fill in what you actually have. Everything here is
# optional in Phase 1: with an empty .env the app runs on local SQLite with
# rule-based agent stubs, and only the (keyless) weather calls go external.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Target: Postgres on Neon (free tier). Example:
#   DATABASE_URL=postgresql+psycopg://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require
# Leave unset to use the local SQLite file ./data/orchestrator.db instead.
DATABASE_URL=

# --- LLM ------------------------------------------------------------------
# Without a key, Recovery and Passenger Comms fall back to deterministic
# rule-based stubs with the same function signatures (see Phase 1 notes).
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
COMMS_MODEL=claude-haiku-4-5

# --- Frontend -------------------------------------------------------------
# Where the Streamlit app looks for the API. Also settable in the sidebar.
API_BASE_URL=http://127.0.0.1:8000/api/v1

# --- Demo behaviour -------------------------------------------------------
# Pause between orchestrator steps, so a Refresh mid-run lands on an
# intermediate state instead of jumping straight to the end.
DEMO_STEP_DELAY_SECONDS=1.2
# Comma-separated browser origins allowed to call the API. Streamlit calls the
# API server-side, so this only matters for direct browser access (/docs).
CORS_ORIGINS=http://localhost:8501

# --- Hub / scenario defaults ---------------------------------------------
HUB_ICAO=VIDP

# --- Phase 4 placeholders (unused in Phase 1, listed so the shape is known)
AVIATIONSTACK_KEY=
RESEND_API_KEY=
TELEGRAM_BOT_TOKEN=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
REDIS_URL=
